# ===== Supabase =====
SUPABASE_URL=https://seu-projeto.supabase.co
# Use a chave secreta (service_role) do Supabase: o backend ignora RLS.
# Dashboard > Project Settings > API > Project API keys > service_role
SUPABASE_KEY=sua-chave-secreta-aqui

# ===== Firebase Admin (Service Account) =====
# Caminho relativo à pasta app/ (ou à raiz do projeto) onde está o JSON da conta de serviço.
# Padrão: app/core/firebase-credentials.json
FIREBASE_CREDENTIALS=core/firebase-credentials.json

# ===== Firebase (project id, opcional) =====
FIREBASE_PROJECT_ID=seu-projeto-id

# ===== Fluxo de agendamento =====
# Tempo de expiração (em minutos) do bloqueio temporário de horário.
AGENDAMENTO_LOCK_TTL_MINUTOS=10

# ===== E-mail (notificações por e-mail) =====
# Deixe EMAIL_ENABLED=false para manter apenas as notificações do sino.
EMAIL_ENABLED=false

# Desenvolvimento: sandbox do Mailtrap (https://mailtrap.io) ou MailHog.
# Mailtrap:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<usuário do inbox>
#   SMTP_PASSWORD=<senha do inbox>
#   SMTP_STARTTLS=true
# MailHog (local):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_STARTTLS=false
#   SMTP_SSL=false

# Produção: servidor SMTP institucional (587 com STARTTLS ou 465 com SSL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NOME=Coordenação SER
SMTP_STARTTLS=true
SMTP_SSL=false

# URL usada no botão "Ver agendamento" do e-mail.
APP_FRONTEND_URL=http://localhost:5173
